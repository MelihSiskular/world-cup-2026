# WC26 Transfer Intelligence API runtime configuration
#
# This file is a safe configuration template.
# The application does not automatically load it.
#
# Docker usage:
#   cp .env.example .env
#   docker run --env-file .env ...
#
# Local shell usage:
#   set -a
#   source .env
#   set +a

# Runtime environment: development, test, or production.
WC26_ENVIRONMENT=production

# Server bind configuration.
WC26_API_HOST=0.0.0.0
# WC26_API_PORT takes precedence over a cloud platform-provided PORT.
# When both variables are absent, the API uses port 8000.
WC26_API_PORT=8000

# Public service identifier used in health and readiness responses.
WC26_SERVICE_NAME=wc26-transfer-intelligence

# Optional API documentation metadata overrides.
# Values must not be empty when enabled.
# WC26_API_TITLE=WC26 Transfer Intelligence API
# WC26_API_SUMMARY=Football recruitment intelligence built from World Cup 2026 data.

# Runtime datasets.
#
# Relative paths work:
# - from the repository root during local development
# - from /app inside the Docker image
WC26_FEATURES_PATH=data/processed/transfer_intelligence/transfer_feature_table.csv
WC26_PLAYER_TOURNAMENT_SUMMARY_PATH=data/processed/player_matches_analysis/player_tournament_full_summary_enriched.csv
WC26_SIMILARITY_PATH=data/processed/player_similarity/player_similarity_breakdown_long.csv
WC26_HEATMAP_SIMILARITY_PATH=data/processed/player_heatmaps/heatmap_similarity_long.csv
WC26_HEATMAP_PROFILES_PATH=data/processed/player_heatmaps/player_heatmap_profiles.csv
WC26_HEATMAP_GRIDS_PATH=data/processed/player_heatmaps/player_heatmap_grids.npz

# Dataset bundle integrity manifest
WC26_DATASET_MANIFEST_PATH=config/runtime_dataset_manifest.json

# Comma-separated browser origins.
#
# Keep empty when no browser frontend should access the API cross-origin.
# Example:
# WC26_CORS_ORIGINS=http://localhost:3000,https://app.example.com
WC26_CORS_ORIGINS=
