# FastAPI backend used only by the Next.js server and route handlers.
#
# Local development:
WC26_API_BASE_URL=http://127.0.0.1:8000

# Vercel Preview and Production:
# WC26_API_BASE_URL=https://world-cup-2026-production.up.railway.app
#
# Do not rename this variable with a NEXT_PUBLIC_ prefix.
# Browser requests must continue through the same-origin Next.js BFF routes.
