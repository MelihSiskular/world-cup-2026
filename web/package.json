{
  "name": "wc26-web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run env:check && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "api:schema:fetch": "node scripts/fetch-openapi.mjs",
    "api:types": "openapi-typescript ./openapi/wc26.openapi.json -o ./src/lib/api/generated/schema.d.ts --alphabetize --immutable",
    "api:types:check": "openapi-typescript ./openapi/wc26.openapi.json -o ./src/lib/api/generated/schema.d.ts --alphabetize --immutable --check",
    "api:contract:refresh": "npm run api:schema:local && npm run api:types",
    "api:schema:local": "python ../scripts/export_openapi_schema.py",
    "api:contract:remote": "npm run api:schema:fetch && npm run api:types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:report": "playwright show-report",
    "env:check": "node --env-file-if-exists=.env.local scripts/validate-environment.mjs",
    "sync:player-images": "node ./scripts/sync-player-images.mjs",
    "predev": "npm run sync:player-images",
    "prebuild": "npm run sync:player-images"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@tanstack/react-query": "^5.101.4",
    "next": "16.2.12",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.84.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true
  }
}
